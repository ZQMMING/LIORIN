{"assertion_id": "ASSERT-SMTH-0001", "source_evidence": ["SMTH-003-001"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "正印", "predicate": "defines", "object": "五行之正库(金命见乙丑/木见癸未/火见甲戌/水土见壬辰丙辰)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "A", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "正印为五行之正库，按命五行对应固定支库：金见乙丑、木见癸未、火见甲戌、水土见壬辰丙辰。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0002", "source_evidence": ["SMTH-003-002"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "華蓋印", "predicate": "defines", "object": "正印之亚型(如亥卯未局得癸未之类)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "華蓋印为正印之一亚型，以亥卯未等局得癸未之类为例。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0003", "source_evidence": ["SMTH-003-003"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "文章印", "predicate": "defines", "object": "正印之亚型(纳音克身、干神相制或干神制支神合)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "文章印为正印之一亚型，由纳音克身、干神相制或干神制支神合而成。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0004", "source_evidence": ["SMTH-003-004"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "正印", "predicate": "avoids", "object": "刑冲破害", "condition": {"positive": "正印逢库基生旺扶助互换禄马贵人并相合", "negative": "", "exception": ""}, "polarity": "negative", "assertion_type": "RELATION", "grade": "A", "consumer": ["SMTH"], "runtime_action": "CHANGE_RELATION", "human_text": "正印要逢库基扶助互换禄马贵人并相合，最忌刑冲破害。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0005", "source_evidence": ["SMTH-003-009"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "臨空印", "predicate": "defines", "object": "印落空亡且支无六合", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "臨空印为正印之一亚型，指印落空亡且支无六合。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0006", "source_evidence": ["SMTH-004-001"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "德秀", "predicate": "defines", "object": "逐月干支对应(寅午戌月丙丁为德戊癸为秀/申子辰月壬癸戊己为德丙辛甲己为秀/巳酉丑月庚辛为德乙庚为秀/亥卯未月甲乙为德丁壬为秀)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "A", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "德秀按月令取干：寅午戌月丙丁为德戊癸为秀，申子辰月壬癸戊己为德丙辛甲己为秀，巳酉丑月庚辛为德乙庚为秀，亥卯未月甲乙为德丁壬为秀。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0007", "source_evidence": ["SMTH-008-007"], "classic": "三命通会", "namespace": "SMTH.time_modifier", "subject": "行运", "predicate": "modifies", "object": "遇羊刃为不利修饰", "condition": {"positive": "大运或流年行至羊刃", "negative": "", "exception": ""}, "polarity": "negative", "assertion_type": "RELATION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "CHANGE_RELATION", "human_text": "行运遇羊刃为不利之运年修饰，仅作引动标记，不改原局结构。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0008", "source_evidence": ["SMTH-009-001"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "空亡", "predicate": "defines", "object": "旬尽十干不到(有位无禄曰空，有支无干曰亡，如甲子旬无戌亥)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "A", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "空亡起于旬尽：十干不到为空，有位无禄曰空、有支无干曰亡，如甲子旬遁至十干足而无戌亥。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0009", "source_evidence": ["SMTH-009-003"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "太岁与日柱", "predicate": "interacts_with", "object": "互换空亡(以实为空则实可映空，以空为空无所映)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "RELATION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "CHANGE_RELATION", "human_text": "太岁与日柱互在对方旬中空亡为互换空亡，其实空相生之理与普通空亡不同。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0010", "source_evidence": ["SMTH-009-003", "SMTH-009-008"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "空亡", "predicate": "is_neutralized_by", "object": "六合(合则不能空)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "positive", "assertion_type": "RELATION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "CHANGE_RELATION", "human_text": "空亡逢合则空亡之力被解，合与空不能并存。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0011", "source_evidence": ["SMTH-009-003"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "真空亡", "predicate": "defines", "object": "无冲无合", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "真空亡指柱中既无冲亦无合之空亡。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0012", "source_evidence": ["SMTH-009-004"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "真空亡", "predicate": "defines", "object": "按旬五行(甲子旬水土/甲戌旬金/甲申旬火土/甲午旬火土/甲辰旬木/甲寅旬水土)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "A", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "真空亡又按旬分五行：甲子旬水土、甲戌旬金、甲申旬火土、甲午旬火土、甲辰旬木、甲寅旬水土。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0013", "source_evidence": ["SMTH-009-006"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "空亡之支", "predicate": "interacts_with", "object": "本命(克命之空亡为忌)", "condition": {"positive": "空亡之支克本命干", "negative": "", "exception": ""}, "polarity": "negative", "assertion_type": "RELATION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "CHANGE_RELATION", "human_text": "空亡之支若克本命干则为忌，与一般空亡相区别。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0014", "source_evidence": ["SMTH-009-008"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "五行逢空", "predicate": "corresponds_to", "object": "各五行之空象(金空则响/火空则明/水空则清/木空则折/土空则崩)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "RELATION", "grade": "A", "consumer": ["SMTH"], "runtime_action": "CHANGE_RELATION", "human_text": "五行逢空各有其象：金空则响、火空则明、水空则清、木空则折、土空则崩。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0015", "source_evidence": ["SMTH-009-009"], "classic": "三命通会", "namespace": "SMTH.time_modifier", "subject": "空亡", "predicate": "activates_on", "object": "运年冲刑(反引动为虚煞)", "condition": {"positive": "原局空亡遇大运流年冲刑", "negative": "", "exception": "同干之支冲之(如壬申冲壬寅)则不引动"}, "polarity": "neutral", "assertion_type": "RELATION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "CHANGE_RELATION", "human_text": "原局空亡遇大运流年冲刑则反被引动为虚煞；唯同干之支冲之则不引动。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0016", "source_evidence": ["SMTH-009-010"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "截路空亡", "predicate": "defines", "object": "按日干取时表(甲己日见申酉/乙庚见午未/丙辛见辰巳/丁壬见寅卯/戊癸见戌亥)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "A", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "截路空亡只以日干取时：甲己日见申酉、乙庚见午未、丙辛见辰巳、丁壬见寅卯、戊癸见戌亥，于所遇壬癸水之时为截路。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0017", "source_evidence": ["SMTH-009-011"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "四大空亡", "predicate": "defines", "object": "按旬所缺五行(甲子甲午旬缺水/甲寅甲申旬缺金)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "A", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "四大空亡按旬所缺五行：甲子甲午旬独缺水、甲寅甲申旬独缺金，此四旬五行不全。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0018", "source_evidence": ["SMTH-009-011"], "classic": "三命通会", "namespace": "SMTH.time_modifier", "subject": "行运", "predicate": "activates", "object": "至四大空亡所缺五行处亦为犯", "condition": {"positive": "原局不犯四大空亡，行运至所缺水金处", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "RELATION", "grade": "B", "consumer": ["SMTH"], "runtime_action": "CHANGE_RELATION", "human_text": "原局不犯四大空亡者，行运至所缺之水金处亦引动为犯，仅作运年引动标记，不改本命格局。", "audit_status": "CANDIDATE"}
{"assertion_id": "ASSERT-SMTH-0019", "source_evidence": ["SMTH-026-001"], "classic": "三命通会", "namespace": "SMTH.special_reference", "subject": "天干", "predicate": "corresponds_to", "object": "五脏六腑(甲胆乙肝丙小肠丁心戊胃己脾庚大肠辛肺壬膀胱癸肾，三焦寄壬包络寄癸)", "condition": {"positive": "", "negative": "", "exception": ""}, "polarity": "neutral", "assertion_type": "DEFINITION", "grade": "A", "consumer": ["SMTH"], "runtime_action": "SUPPORT_STATE", "human_text": "干支配脏腑：甲胆乙肝、丙小肠丁心、戊胃己脾、庚大肠辛肺、壬膀胱癸肾，三焦寄壬、包络寄癸。", "audit_status": "CANDIDATE"}
