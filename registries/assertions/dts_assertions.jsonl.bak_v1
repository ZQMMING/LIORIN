{"assertion_id": "ASSERT-DTS-0341", "source_evidence": ["DTS-055-008"], "classic": "滴天髓", "namespace": "DTS.shape", "subject": "清浊", "predicate": "requires", "object": "遍观局中各处皆有之", "condition": {"positive": "不专在财官印绶，格局、气象、用神、合神、日主、化气、从气、精气神、收藏发生、意向节度、情性理势、源流主从之间皆有清浊", "negative": "只从财官印绶一处分清浊", "exception": ""}, "polarity": "neutral", "grade": "B", "consumer": ["DTS"], "runtime_action": "CONTEXT_MARKER", "human_text": "清浊遍布局中每一处，不可只就财官印看", "audit_status": "CANDIDATE", "assertion_type": "DEFINITION"}
{"assertion_id": "ASSERT-DTS-0342", "source_evidence": ["DTS-055-008"], "classic": "滴天髓", "namespace": "DTS.shape", "subject": "辨清浊之法", "predicate": "requires", "object": "先寻皮面之形再寻精髓", "condition": {"positive": "先于皮面影上寻其形，得其形而后寻其精髓", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "B", "consumer": ["DTS"], "runtime_action": "CONTEXT_MARKER", "human_text": "辨清浊先观表面形影，再推深层精髓", "audit_status": "CANDIDATE", "assertion_type": "CONDITION"}
{"assertion_id": "ASSERT-DTS-0343", "source_evidence": ["DTS-056-001"], "classic": "滴天髓", "namespace": "DTS.flow", "subject": "岁与运", "predicate": "determines", "object": "战冲之降与和好之切", "condition": {"positive": "休咎系乎运亦系乎岁; 战冲视其孰降，和好视其孰切", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "A", "consumer": ["DTS"], "runtime_action": "CHANGE_RELATION", "human_text": "岁运相交: 战冲看谁降伏，和好看谁亲切", "audit_status": "CANDIDATE", "assertion_type": "DEFINITION"}
{"assertion_id": "ASSERT-DTS-0344", "source_evidence": ["DTS-056-002"], "classic": "滴天髓", "namespace": "DTS.flow", "subject": "运伐岁与岁伐运", "predicate": "separates", "object": "名之先后", "condition": {"positive": "丙运庚年为运伐岁; 庚运丙年为岁伐运", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "B", "consumer": ["DTS"], "runtime_action": "CONTEXT_MARKER", "human_text": "岁运相战以干支先后分伐岁伐运", "audit_status": "CANDIDATE", "assertion_type": "DEFINITION"}
{"assertion_id": "ASSERT-DTS-0345", "source_evidence": ["DTS-056-002"], "classic": "滴天髓", "namespace": "DTS.tongguan", "subject": "岁运交战而喜者不肯降", "predicate": "requires_mediator", "object": "和之之干", "condition": {"positive": "日主喜庚而岁不肯降、或喜丙而运不肯降，得戊己以和为妙", "negative": "", "exception": ""}, "polarity": "positive", "grade": "B", "consumer": ["DTS"], "runtime_action": "SUPPORT_STATE", "human_text": "岁运相战于所喜一行，取中间一行和之", "audit_status": "CANDIDATE", "assertion_type": "RELATION"}
{"assertion_id": "ASSERT-DTS-0346", "source_evidence": ["DTS-056-002"], "classic": "滴天髓", "namespace": "DTS.qi_shi", "subject": "一方坐支得地力大", "predicate": "activates", "object": "对方自降", "condition": {"positive": "如庚坐寅午丙之力大，则岁亦不得不降; 庚坐寅午丙力大则运自降", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "B", "consumer": ["DTS"], "runtime_action": "CHANGE_RELATION", "human_text": "交战一方坐支得地力大，彼方自降", "audit_status": "CANDIDATE", "assertion_type": "CONDITION"}
{"assertion_id": "ASSERT-DTS-0347", "source_evidence": ["DTS-057-001"], "classic": "滴天髓", "namespace": "DTS.flow", "subject": "运冲岁/岁冲", "predicate": "requires", "object": "看日主所喜+党多+干头助制", "condition": {"positive": "日主喜子则要助子，又得午之干头乃制午之神; 或午党多干头遇丙戊甲助午者，及日主喜午而子壬党多干头助子者", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "A", "consumer": ["DTS"], "runtime_action": "CHANGE_RELATION", "human_text": "岁运相冲看喜何方、何方党多、干头助谁制谁", "audit_status": "CANDIDATE", "assertion_type": "CONDITION"}
{"assertion_id": "ASSERT-DTS-0348", "source_evidence": ["DTS-057-001"], "classic": "滴天髓", "namespace": "DTS.qi_shi", "subject": "彼重此轻", "predicate": "stops_at", "object": "相降", "condition": {"positive": "若午重子轻，则岁不降亦无咎", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "A", "consumer": ["DTS"], "runtime_action": "SUPPORT_STATE", "human_text": "相冲一方过重则彼不降亦不为害", "audit_status": "CANDIDATE", "assertion_type": "EXCEPTION"}
{"assertion_id": "ASSERT-DTS-0349", "source_evidence": ["DTS-058-001"], "classic": "滴天髓", "namespace": "DTS.flow", "subject": "岁运天干相合", "predicate": "determines", "object": "为和", "condition": {"positive": "乙运庚年、庚运乙年、子运丑年、丑运子年则和", "negative": "不合者不为和", "exception": ""}, "polarity": "neutral", "grade": "A", "consumer": ["DTS"], "runtime_action": "CHANGE_RELATION", "human_text": "岁运天合地合即为和，其向背随日主所喜", "audit_status": "CANDIDATE", "assertion_type": "RELATION"}
{"assertion_id": "ASSERT-DTS-0350", "source_evidence": ["DTS-059-001"], "classic": "滴天髓", "namespace": "DTS.flow", "subject": "岁运同气相邻", "predicate": "determines", "object": "为好", "condition": {"positive": "庚运辛年、辛运庚年、申运酉年、酉运申年则好", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "A", "consumer": ["DTS"], "runtime_action": "SUPPORT_STATE", "human_text": "岁运同气异阴阳相邻为好; 喜阳取庚申、喜阴取辛酉", "audit_status": "CANDIDATE", "assertion_type": "RELATION"}
{"assertion_id": "ASSERT-DTS-0351", "source_evidence": ["DTS-060-001"], "classic": "滴天髓", "namespace": "DTS.qi_shi", "subject": "造化", "predicate": "determines", "object": "起元止贞而复始", "condition": {"positive": "造化起于元亦止于贞，再肇贞元之会，胚胎嗣续之机", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "A", "consumer": ["DTS"], "runtime_action": "CONTEXT_MARKER", "human_text": "贞元: 一气之终即一气之始，循环不穷", "audit_status": "CANDIDATE", "assertion_type": "DEFINITION"}
{"assertion_id": "ASSERT-DTS-0352", "source_evidence": ["DTS-060-002"], "classic": "滴天髓", "namespace": "DTS.qi_shi", "subject": "四柱", "predicate": "separates", "object": "年月元亨与日时利贞", "condition": {"positive": "以年为元月为亨日为利时为贞", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "B", "consumer": ["DTS"], "runtime_action": "CONTEXT_MARKER", "human_text": "四柱自年月至日时分前半后半之气", "audit_status": "CANDIDATE", "assertion_type": "DEFINITION"}
{"assertion_id": "ASSERT-DTS-0353", "source_evidence": ["DTS-060-002"], "classic": "滴天髓", "namespace": "DTS.qi_shi", "subject": "大运", "predicate": "separates", "object": "初后各十五之元亨利贞", "condition": {"positive": "初十五年为元、次十五年为亨、中十五年为利、后十五年为贞", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "B", "consumer": ["DTS"], "runtime_action": "CONTEXT_MARKER", "human_text": "大运以十五年一段分元亨利贞", "audit_status": "CANDIDATE", "assertion_type": "DEFINITION"}
{"assertion_id": "ASSERT-DTS-0354", "source_evidence": ["DTS-060-002"], "classic": "滴天髓", "namespace": "DTS.qi_shi", "subject": "贞下起元", "predicate": "activates", "object": "续续之机", "condition": {"positive": "考为贞子为元，贞下起元为生生不息之机", "negative": "", "exception": ""}, "polarity": "neutral", "grade": "B", "consumer": ["DTS"], "runtime_action": "CONTEXT_MARKER", "human_text": "前运之终即后运之始，气脉不断", "audit_status": "CANDIDATE", "assertion_type": "DEFINITION"}
