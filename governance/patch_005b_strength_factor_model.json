      "relation": "DRAINED_BY",
      "source_ids": ["QTBJ-030-001"],
      "evidence_grade": "A",
      "forbidden": ["drain_amount 量化"]
    },
    {
      "factor_id": "FCT-TREND-001",
      "factor_type": "TREND",
      "sub_factors": ["五阳从气不从势/气势方向"],
      "note": "势独立；禁 trend→strength",
      "object": "五行群体",
      "relation": "TREND_TO",
      "source_ids": ["DTS-008-003", "DTS-008-022"],
      "evidence_grade": "A",
      "forbidden": ["trend→strength_state", "trend=strength"]
    },
    {
      "factor_id": "FCT-SEASONAL-001",
      "factor_type": "SEASONAL",
      "sub_factors": ["当权/失令/寒暖燥湿"],
      "note": "⚠️ QTBJ-018-001 为 CANDIDATE_RULE 级：005B 阶段须先升格核验或换 QTBJ-060-001/QTBJ-109-001（调候 CORE），否则 FAIL_CLOSED",
      "object": "DAYMASTER",
      "relation": "SEASONAL_CONDITION",
      "source_ids": ["QTBJ-018-001", "QTBJ-060-001", "QTBJ-109-001"],
      "evidence_grade": "A（060/109）；CANDIDATE（018）",
      "forbidden": ["seasonal→STRONG", "seasonal→统一旺衰公式"]
    }
  ],
  "factor_output_schema": {
