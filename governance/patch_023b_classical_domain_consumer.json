        "responsible": ["病药", "救应", "取用条件"],
        "allowed_input_states": ["problem_relation", "support_relation", "control_relation", "structure_relation"],
        "forbidden_inputs": ["PZZQ_useful", "DTS_strength"],
        "consumer_mode": "DIRECT",
        "output_permission": ["problem_state", "medicine_state"]
      },
      {
        "domain_id": "YHZP_BASIC",
        "classical_scope": "YHZP",
        "responsible": ["基础十神", "干支", "五行关系", "部分旺衰表达"],
        "allowed_input_states": ["ten_god_relation", "element_relation", "root_relation", "season_relation"],
        "forbidden_inputs": ["现代评分模型"],
        "consumer_mode": "DIRECT",
        "output_permission": ["ten_god_state", "element_relation_state"]
      },
      {
        "domain_id": "SMTH_SUIYUN",
        "classical_scope": "SMTH/五行精纪",
        "responsible": ["岁运", "起运", "时间体系"],
        "allowed_input_states": ["time_object", "luck_cycle", "year_cycle"],
        "forbidden_inputs": ["直接参与 strength_state"],
        "consumer_mode": "SUPPORTING",
        "output_permission": ["luck_cycle", "year_cycle"]
      }
    ]
  },
  "consumer_mode": {
    "principle": "消费权限等级",
    "levels": [
      {"code": "DIRECT", "meaning": "直接生产状态（如月令→order_state）"},
      {"code": "FACT_ONLY", "meaning": "只能读取事实（如神煞）"},
      {"code": "DISPLAY_ONLY", "meaning": "仅展示"},
      {"code": "SUPPORTING", "meaning": "辅助证明（如 DTS 中和辅助）"},
      {"code": "FORBIDDEN", "meaning": "禁止消费"}
    ]
  },
  "concept_namespace": {
    "principle": "同一个字段在不同经典不是同一个变量",
    "examples": [
      {"surface": "strength", "namespaced": ["DTS.strength_relation", "PZZQ.strength_condition", "QTBJ.climate_condition"], "note": "三个不是同一个变量"},
