    "YHZP": {"allowed": {"ten_god_relation": "偏印正印比肩正印", "element_relation": "WATER_VISIBLE_SUPPORT+ROOTED_SUPPORT", "root_relation": "WEAK_ROOT", "season_relation": "戌月"}, "forbidden_hit": "无", "entry": "基础十神/干支/五行（YHZP 域）"},
    "SMTH": {"allowed": {"time_object": "1983-11-03 11:30", "luck_cycle": "未启动", "year_cycle": "未启动"}, "forbidden_hit": "无", "entry": "岁运时间体系（SUPPORTING）"},
    "global_forbidden": "任何经典不得：水三透=身强；乙木戌月=乙木弱"
  },
  "acceptance_criteria": [
    "六经典 × allowed × forbidden × consumer_mode 全注册",
    "concept_namespace 拆分（旺/强/用/病/清/浊）",
    "1983-1103 六经典消费演示：各域只读自己 allowed 状态",
    "禁跨域直判（水三透≠身强）",
    "不产生任何命理结论，不写 Strength Rule"
  ]
