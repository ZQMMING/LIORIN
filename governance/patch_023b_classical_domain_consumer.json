    "PZZQ": {"allowed": {"order_state": "NOT_GET_ORDER", "month_order": "戌", "ten_god_relation": "偏印正印比肩正印", "root_relation": "WEAK_ROOT"}, "forbidden_hit": "无", "entry": "格局规则（PZZQ 域，格局层未启动）"},
