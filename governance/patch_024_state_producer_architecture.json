  "purpose": "定义子平引擎消费排盘输出后的计算架构——State Producer 七层依赖顺序。排盘引擎独立；本契约只规定状态生产层。",
  "scope_boundary": "排盘引擎保持独立，83 字段排盘输出仅作为 Input Contract；本契约不升级排盘引擎。",
  "dependency_order": [
    {"layer": 1, "name": "对象识别层 Object Layer", "output": ["day_master_element", "ten_god_type"], "type": "ENUM", "input": "四柱/藏干/月令/日主", "note": "不用 Boolean"},
    {"layer": 2, "name": "事实 Boolean 层 Fact Boolean Layer", "output": ["has_root", "has_visible_resource", "has_visible_wealth", "has_visible_authority", "has_clash", "has_combination", "has_transformation_condition", "has_following_structure_condition"], "type": "BOOLEAN", "input": "四柱/藏干/十神/关系", "note": "只表达有没有，不表达强弱"},
    {"layer": 3, "name": "基础 Enum 层 Base Enum Layer", "output": ["order_state", "root_state", "support_state"], "type": "ENUM", "input": "月令/藏干/印比位置透藏", "note": "多态枚举；有根≠强"},
    {"layer": 4, "name": "关系 Enum 层 Relation Enum Layer", "output": ["resource_relation_state", "wealth_relation_state", "authority_relation_state"], "type": "ENUM", "input": "十神位置/透藏/月令/制化/日主承受", "note": "解决多；印=3 不等于印多"},
    {"layer": 5, "name": "旺衰层 Prosperity Layer", "output": ["wang_state", "shuai_state"], "type": "ENUM", "input": "时令/季节/月令为主，非根、非印比数量", "note": "旺≠强；衰≠弱"},
    {"layer": 6, "name": "强弱层 Strength Layer", "output": ["strength_state"], "type": "ENUM", "input": "order+root+support+resource_relation+wealth_relation+authority_relation+drain_relation+trend_state", "note": "RELATIONAL_RESULT；禁 if root=true→strong；禁 count>3→strong；禁 score"},
    {"layer": 7, "name": "格局/用神层 Pattern/Use-God Layer", "output": ["pattern_state", "use_god_state"], "type": "ENUM", "input": "前六层输出+格局规则", "note": "后续 PATCH 冻结"}
  ],
