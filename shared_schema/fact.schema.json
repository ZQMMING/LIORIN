{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisdom.shuntian/schema/fact.schema.json",
  "title": "FactRecord",
  "description": "V2.2.2 FINAL §B-4/F-4/G-2/H-3/I-2/J-3 各引擎 Derived Fact。每个 Fact 必须有 source_rule_id 可追溯；禁止评分/百分比。",
  "type": "object",
  "additionalProperties": false,
  "required": ["fact_id", "engine", "fact_type", "source_rule_id"],
  "properties": {
    "fact_id": { "type": "string", "pattern": "^F-[A-Z]{4}-[0-9]{3}-[0-9]{3}$" },
    "engine": {
      "type": "string",
      "enum": [
        "YUHAI_ZIPING", "ZIPING_ZHENQUAN", "DITIANSUI",
        "QIONGTONG_BAOJIAN", "SANMING_TONGHUI", "SHENFENG_TONGKAO"
      ]
    },
    "fact_type": {
      "type": "string",
      "enum": [
        "ten_god", "six_relative", "palace", "basic_structure", "geju_candidate", "relation",
        "month_order", "formation", "destruction", "rescue", "xiangshen",
        "seasonal", "root", "support", "drain_control", "qi",
        "climate", "environment", "requirement", "supporting_condition", "blocking_condition",
        "effectiveness", "combination", "activation", "time_layer", "shensha_activation",
        "disease", "medicine", "bingyao", "dayun_dai_yao", "dongjing", "gaitou"
      ]
    },
    "source_rule_id": { "type": "string", "pattern": "^(CAND-)?[A-Z]{4}-[0-9]{3}$" },
    "fields": {
      "type": "object",
      "additionalProperties": true,
      "description": "各 fact_type 的字段（position/ten_god/value 等），由对应 Engine Contract 约束"
    },
    "evidence_ids": { "type": "array", "items": { "type": "string" } }
  }
}
