{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisdom.shuntian/schema/contract.schema.json",
  "title": "EngineContract",
  "description": "V2.2.2 FINAL §K-11/§80 Contract：Contract Freeze 锁定 field/type/required/enum/dependency/forbidden input/forbidden output；不锁定 business truth。",
  "type": "object",
  "additionalProperties": false,
  "required": ["engine", "contract_version", "engine_version", "input", "output", "forbidden_input", "forbidden_output", "dependency", "approved_by", "approved_at"],
  "properties": {
    "engine": {
      "type": "string",
      "enum": [
        "YUHAI_ZIPING", "ZIPING_ZHENQUAN", "DITIANSUI",
        "QIONGTONG_BAOJIAN", "SANMING_TONGHUI", "SHENFENG_TONGKAO"
      ]
    },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "engine_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_fields", "allowed_engines"],
      "properties": {
        "allowed_fields": { "type": "array", "items": { "type": "string" } },
        "allowed_engines": { "type": "array", "items": { "type": "string" } }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_groups", "judgment_fields", "statuses"],
      "properties": {
        "fact_groups": { "type": "array", "items": { "type": "string" } },
        "judgment_fields": { "type": "array", "items": { "type": "string" } },
        "statuses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "forbidden_input": { "type": "array", "items": { "type": "string" } },
    "forbidden_output": { "type": "array", "items": { "type": "string" } },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads"],
      "properties": {
        "reads": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "approved_by": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "format": "date-time" }
  }
}
