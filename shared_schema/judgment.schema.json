{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisdom.shuntian/schema/judgment.schema.json",
  "title": "JudgmentRecord",
  "description": "V2.2.2 FINAL §F-10/§67 Judgment：必须 Fact→Rule→Evidence→Judgment；没有证据则 UNKNOWN，不得 Agent 自行推断。",
  "type": "object",
  "additionalProperties": false,
  "required": ["judgment_id", "engine", "subject", "predicate", "value", "basis_fact_ids", "source_rule_ids", "evidence_ids", "status"],
  "properties": {
    "judgment_id": { "type": "string", "pattern": "^J-[A-Z]{4}-[0-9]{3}$" },
    "engine": {
      "type": "string",
      "enum": [
        "YUHAI_ZIPING", "ZIPING_ZHENQUAN", "DITIANSUI",
        "QIONGTONG_BAOJIAN", "SANMING_TONGHUI", "SHENFENG_TONGKAO"
      ]
    },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "value": { "type": ["string", "number", "boolean", "null"] },
    "basis_fact_ids": { "type": "array", "items": { "type": "string" } },
    "source_rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["PASS", "UNKNOWN", "RULE_NOT_APPLICABLE"]
    }
  }
}
