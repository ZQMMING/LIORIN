{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisdom.shuntian/schema/precedence.schema.json",
  "title": "PrecedenceRecord",
  "description": "V2.2.2 FINAL §C-1/§108 Local Precedence：同一方法、同一范围、同一规则系统内部的局部优先关系；禁止全局经典等级。",
  "type": "object",
  "additionalProperties": false,
  "required": ["precedence_id", "higher_rule", "lower_rule", "scope", "reason", "source_evidence_ids", "version", "status"],
  "properties": {
    "precedence_id": { "type": "string", "pattern": "^PREC-[0-9]{3}$" },
    "higher_rule": { "type": "string", "pattern": "^(CAND-)?[A-Z]{4}-[0-9]{3}$" },
    "lower_rule": { "type": "string", "pattern": "^(CAND-)?[A-Z]{4}-[0-9]{3}$" },
    "scope": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "source_evidence_ids": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "type": "string", "enum": ["CANDIDATE", "APPROVED", "REJECTED", "FROZEN"] }
  }
}
