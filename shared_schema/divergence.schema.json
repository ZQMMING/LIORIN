{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisdom.shuntian/schema/divergence.schema.json",
  "title": "DivergenceRecord",
  "description": "V2.2.2 FINAL §M-9/§109-110 CLASSICAL_DIVERGENCE：同一语义 subject + 同一 predicate + 同一 scope + 两个以上有效 Source/Rule + 不同合法 value 才触发。",
  "type": "object",
  "additionalProperties": false,
  "required": ["divergence_id", "subject", "predicate", "scope", "positions", "status"],
  "properties": {
    "divergence_id": { "type": "string", "pattern": "^DIV-[0-9]{3}$" },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "positions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["engine", "value", "rule_ids", "source_ids"],
        "properties": {
          "engine": {
            "type": "string",
            "enum": [
              "YUHAI_ZIPING", "ZIPING_ZHENQUAN", "DITIANSUI",
              "QIONGTONG_BAOJIAN", "SANMING_TONGHUI", "SHENFENG_TONGKAO"
            ]
          },
          "value": { "type": ["string", "number", "boolean"] },
          "rule_ids": { "type": "array", "items": { "type": "string" } },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "HUMAN_REVIEW"] }
  }
}
