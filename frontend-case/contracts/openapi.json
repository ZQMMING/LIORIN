  "components": {
    "schemas": {
      "BirthTime": {
        "properties": {
          "hour": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Hour",
            "description": "solar hour 0-23"
          },
          "minute": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 59.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Minute",
            "description": "birth minute 0-59; None = 时辰中点"
          }
        },
        "type": "object",
        "required": [
          "hour"
        ],
        "title": "BirthTime",
        "description": "Birth clock time: hour + optional minute (None = 时辰中点)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "pairing_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pairing Code"
          }
        },
        "type": "object",
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "token_version": {
            "type": "integer",
            "title": "Token Version"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "access_token",
          "refresh_token",
          "expires_in",
          "token_version"
        ],
        "title": "LoginResponse"
      },
      "LogoutRequest": {
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          },
          "all_devices": {
            "type": "boolean",
            "title": "All Devices",
            "default": false
          }
        },
        "type": "object",
        "title": "LogoutRequest"
      },
      "MeResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "is_new_user": {
            "type": "boolean",
            "title": "Is New User"
          },
          "has_birth_info": {
            "type": "boolean",
            "title": "Has Birth Info"
          },
          "has_heluo_model": {
            "type": "boolean",
            "title": "Has Heluo Model"
          },
          "devices": {
            "items": {},
            "type": "array",
            "title": "Devices"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "is_new_user",
          "has_birth_info",
          "has_heluo_model",
          "devices"
        ],
        "title": "MeResponse"
      },
      "ProfileRequest": {
        "properties": {
          "birth_date": {
            "type": "string",
            "title": "Birth Date",
            "description": "YYYY-MM-DD"
          },
          "birth_time": {
            "$ref": "#/components/schemas/BirthTime"
          },
          "gender": {
            "type": "string",
            "pattern": "^(male|female)$",
            "title": "Gender",
            "description": "Required per Profile Contract §1.2 (forbidden_default=true)."
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone",
            "description": "IANA timezone; resolvable from location"
          },
          "calendar_system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calendar System",
            "description": "solar | lunar (lunar unsupported in V1)",
            "default": "solar"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location",
            "description": "location id / name from backend/data/locations.json — 出生地(Natal Calculation Context, 用于真太阳时→派生时区→排盘)"
          },
          "current_location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Location",
            "description": "[环境层·仅记录] 当前生活城市 id/name from locations.json; V1 必填收集但不参与排盘"
          },
          "analysis_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Date",
            "description": "YYYY-MM-DD; default today"
          }
        },
        "type": "object",
        "required": [
          "birth_date",
          "birth_time",
          "gender"
        ],
        "title": "ProfileRequest",
        "description": "POST /v1/profile — §32 profile validation + time-policy receipt (stateless)."
      },
      "ReadingRequest": {
        "properties": {
          "birth_date": {
            "type": "string",
            "title": "Birth Date",
            "description": "YYYY-MM-DD"
          },
          "hour": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Hour",
            "description": "solar hour 0-23"
          },
          "gender": {
            "type": "string",
            "pattern": "^(male|female)$",
            "title": "Gender",
            "description": "Required per Profile Contract §1.2 (forbidden_default=true)."
          },
          "theme": {
            "type": "string",
            "minLength": 1,
            "title": "Theme",
            "default": "WORK"
          },
          "analysis_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Date",
            "description": "YYYY-MM-DD; default today"
          },
          "birth_minute": {
            "anyOf": [
